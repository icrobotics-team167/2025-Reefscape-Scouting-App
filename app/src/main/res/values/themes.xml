<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ScoutingAppV3Dark" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/md_theme_light_scrim</item>
        <item name="android:buttonTint">@color/md_theme_light_tertiary1</item>
    </style>
    <style name="Theme.ScoutingAppV3Dark.coralText" parent="Theme.ScoutingAppV3Dark">
        <!-- Primary brand color. -->
        <item name="android:textSize">40sp</item>
    </style>
    <style name="Theme.ScoutingAppV3Dark.bigText" parent="Theme.ScoutingAppV3Dark">
        <!-- Primary brand color. -->
        <item name="android:textSize">25sp</item>
    </style>


    <style name="Widget.ScoutingAppV3Dark" parent="Theme.ScoutingAppV3Dark">
        <!-- Primary brand color. -->
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/md_theme_light</item>
        <item name="android:background">@drawable/button_smoothing</item>
    </style>
    <style name="Widget.ScoutingAppV3Dark.primary1" parent="Widget.ScoutingAppV3Dark">
        <!-- Primary brand color. -->
        <item name="android:backgroundTint">@color/md_theme_light_primary1</item>
    </style>
    <style name="Widget.ScoutingAppV3Dark.primary2" parent="Widget.ScoutingAppV3Dark">
        <!-- Primary brand color. -->
        <item name="android:backgroundTint">@color/md_theme_light_primary2</item>
    </style>
    <style name="Widget.ScoutingAppV3Dark.secondary1" parent="Widget.ScoutingAppV3Dark">
        <!-- Secondary brand color. -->
        <item name="android:backgroundTint">@color/md_theme_light_secondary1</item>
    </style>
    <style name="Widget.ScoutingAppV3Dark.secondary2" parent="Widget.ScoutingAppV3Dark">
        <!-- Secondary brand color. -->
        <item name="android:backgroundTint">@color/md_theme_light_secondary2</item>
    </style>
    <style name="Widget.ScoutingAppV3Dark.tertiary1" parent="Widget.ScoutingAppV3Dark">
        <!-- Tertiary brand color. -->
        <item name="android:backgroundTint">@color/md_theme_light_tertiary1</item>
    </style>
    <style name="Widget.ScoutingAppV3Dark.tertiary2" parent="Widget.ScoutingAppV3Dark">
        <!-- Tertiary brand color. -->
        <item name="android:backgroundTint">@color/md_theme_light_tertiary2</item>
    </style>
</resources>
