                                        style="@style/Theme.ScoutingAppV3Dark.primary"
                                        android:text="@string/decrement_button_text" />

                                    <TextView
                                        android:id="@+id/DereefedAlgaeValue"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:text="@string/dereefed_algae_value" />

                                    <Button
                                        android:id="@+id/DereefedAlgaeIncButton"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        style="@style/Theme.ScoutingAppV3Dark.primary"
                                        android:text="@string/increment_button_text" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="3"
                                    android:orientation="horizontal"
                                    android:weightSum="4">

                                    <TextView
                                        android:id="@+id/NetMissedAlgaeText"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:text="@string/net_missed_algae_text" />

                                    <Button
                                        android:id="@+id/NetMissedAlgaeDecButton"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        style="@style/Theme.ScoutingAppV3Dark.primary"
                                        android:text="@string/decrement_button_text" />

                                    <TextView
                                        android:id="@+id/NetMissedAlgaeValue"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:text="@string/net_missed_algae_value" />

                                    <Button
                                        android:id="@+id/NetMissedAlgaeIncButton"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        style="@style/Theme.ScoutingAppV3Dark.primary"
                                        android:text="@string/increment_button_text" />

                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/divider3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?android:attr/listDivider" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/NotesTextBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:ems="10"
                android:hint="TEMPORARY HINT TEXT"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/SubmitButton"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    style="@style/Theme.ScoutingAppV3Dark.tertiary"
                    android:text="@string/submit_button_text" />

                <Button
                    android:id="@+id/SkipButton"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    style="@style/Theme.ScoutingAppV3Dark.tertiary"
                    android:text="@string/skip_button_text" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>